{
  "$schema": "https://github.com/Azure/data-api-builder/releases/download/v2.1.5/dab.draft.schema.json",
  "data-source": {
    "database-type": "mssql",
    "connection-string": "@env('DATABASE_CONNECTION_STRING')",
    "options": {
      "set-session-context": false
    }
  },
  "runtime": {
    "rest": {
      "enabled": true,
      "path": "/api",
      "request-body-strict": false
    },
    "graphql": {
      "enabled": true,
      "path": "/graphql",
      "allow-introspection": true
    },
    "mcp": {
      "enabled": true,
      "path": "/mcp"
    },
    "host": {
      "cors": {
        "origins": [],
        "allow-credentials": false
      },
      "authentication": {
        "provider": "Unauthenticated"
      },
      "mode": "development"
    },
    "telemetry": {
      "open-telemetry": {
        "enabled": true,
        "endpoint": "@env('OTEL_EXPORTER_OTLP_ENDPOINT')",
        "headers": "@env('OTEL_EXPORTER_OTLP_HEADERS')",
        "service-name": "@env('OTEL_SERVICE_NAME')"
      }
    }
  },
  "autoentities": {},
  "entities": {
    "Category": {
      "source": {
        "object": "dbo.Categories",
        "type": "table"
      },
      "fields": [],
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "Category",
          "plural": "Categories"
        }
      },
      "rest": {
        "enabled": true
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ],
      "relationships": {
        "products": {
          "cardinality": "many",
          "target.entity": "Product",
          "source.fields": [
            "CategoryID"
          ],
          "target.fields": [
            "CategoryID"
          ],
          "linking.source.fields": [],
          "linking.target.fields": []
        }
      }
    },
    "Product": {
      "source": {
        "object": "dbo.Products",
        "type": "table"
      },
      "fields": [
        {
          "name": "ProductID",
          "alias": "id",
          "primary-key": false
        },
        {
          "name": "ProductName",
          "alias": "name",
          "primary-key": false
        },
        {
          "name": "UnitPrice",
          "alias": "price",
          "primary-key": false
        },
        {
          "name": "UnitsInStock",
          "alias": "stockQuantity",
          "primary-key": false
        },
        {
          "name": "Discontinued",
          "alias": "isDiscontinued",
          "primary-key": false
        }
      ],
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "Product",
          "plural": "Products"
        }
      },
      "rest": {
        "enabled": true
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        },
        {
          "role": "authenticated",
          "actions": [
            {
              "action": "*"
            }
          ]
        }
      ],
      "relationships": {
        "category": {
          "cardinality": "one",
          "target.entity": "Category",
          "source.fields": [
            "CategoryID"
          ],
          "target.fields": [
            "CategoryID"
          ],
          "linking.source.fields": [],
          "linking.target.fields": []
        }
      }
    },
    "ProductCatalog": {
      "source": {
        "object": "dbo.ProductCatalogView",
        "type": "view",
        "key-fields": [
          "ProductID"
        ]
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "ProductCatalog",
          "plural": "ProductCatalogs"
        }
      },
      "rest": {
        "enabled": true
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    }
  }
}